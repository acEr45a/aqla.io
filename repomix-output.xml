import React, { useEffect, useState } from "react";
import { base44 } from "@/api/base44Client";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { ShieldCheck, UserRound, Stethoscope } from "lucide-react";

const ROLE_TONE = {
  admin: "bg-primary/10 text-primary",
  clinician: "bg-[#7B94FF]/10 text-[#7B94FF]",
  user: "bg-secondary text-muted-foreground",
};

const ROLE_ICON = {
  admin: ShieldCheck,
  clinician: Stethoscope,
  user: UserRound,
};

export default function AdminRolePanel() {
  const [state, setState] = useState(null);
  const [busyId, setBusyId] = useState(null);
  const [error, setError] = useState("");

  const load = async (payload = {}) => {
    const response = await base44.functions.invoke("manageUserRoles", payload);
    setState(response.data);
  };

  useEffect(() => { load(); }, []);

  const setRole = async (userId, role) => {
