        const reason = state === "unmet" ? "unchecked"
          : state === "unmet-no-evidence" ? "checked but EVIDENCE pending"
            : "checked but automatic evidence is stale or unbound";
        console.log("  UNMET " + qualify(ledger.file, gate.id) + " (" +
          reason + "): " + gate.title);
