          <span className={`px-2.5 py-1 rounded-full border text-[11px] ${switched ? "text-[#7B94FF] border-[#7B94FF]/40" : "text-[#C9F24E] border-[#C9F24E]/40"}`}>
            {switched ? "Switched" : "Continued"}
