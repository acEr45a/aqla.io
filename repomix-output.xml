          className="mt-8 px-7 py-3.5 rounded-full bg-primary text-primary-foreground text-sm font-medium">Continue</button>
      </div>
    );
  }

  if (phase === "showing") {
    const meterTotal = condition === "forward" ? MAX_FORWARD - FORWARD_START + 1 : MAX_BACKWARD - BACKWARD_START + 1;
