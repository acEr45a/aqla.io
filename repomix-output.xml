              <p className="text-[11px] uppercase tracking-widest text-muted-foreground">{label}</p>
              <p className={`mt-1.5 text-foreground/90 leading-relaxed ${compact ? "text-[13px]" : "text-sm"}`}>{message[key]}</p>
            </div>
          ))}
