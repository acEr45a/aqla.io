<file path="extension/sidepanel.css">
/* extension/sidepanel.css */
/* Aqla Neurological Companion — Electric Lime & Dark Obsidian Design System */

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #090d16;           /* Deep Obsidian */
  --bg-subtle: #121926;    /* Slate 900 */
  --card: #151e30;         /* Surface Card */
  --border: rgba(255, 255, 255, 0.08);
  --border-active: rgba(198, 255, 0, 0.5);
  
  --text: #f8fafc;
  --text-muted: #94a3b8;
  
  /* Aqla Signature Electric Lime Brand Accent */
  --lime: #C6FF00;
  --lime-hover: #b4ea00;
  --lime-glow: rgba(198, 255, 0, 0.35);
  --lime-fg: #090d16;

  --primary: #3b82f6;      /* Secondary Blue */
  --success: #10b981;      /* Emerald */
  --warning: #f59e0b;      /* Amber */
  --danger: #f43f5e;       /* Rose Red */

  --font: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
  --radius: 12px;
}

body {
  background-color: var(--bg);
  color: var(--text);
  font-family: var(--font);
  font-size: 13.5px;
  line-height: 1.5;
  min-height: 100vh;
  margin: 0;
  display: flex;
  flex-direction: column;
}

.app-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 16px;
  box-sizing: border-box;
  position: relative;
}

/* ─── Header ──────────────────────────────────────────────────────────────── */
.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 14px;
}

.logo-cluster {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo-mark {
  width: 30px;
  height: 30px;
  background: var(--lime);
  color: var(--lime-fg);
  font-weight: 900;
  font-size: 13px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: -0.5px;
  box-shadow: 0 0 16px var(--lime-glow);
}

.brand-title {
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.06em;
}

.companion-tag {
  font-size: 9.5px;
  color: var(--lime);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-weight: 700;
  display: block;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.icon-btn {
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 4px 6px;
  font-size: 12px;
  cursor: pointer;
  color: var(--text-muted);
  transition: all 0.15s;
}

.icon-btn:hover {
  border-color: var(--lime);
}

.user-pill {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 26px;
  height: 26px;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
  color: var(--lime);
}

/* ─── Medical Banner ──────────────────────────────────────────────────────── */
.medical-banner {
  background: rgba(59, 130, 246, 0.08);
  border: 1px solid rgba(59, 130, 246, 0.2);
  border-radius: 8px;
  padding: 6px 10px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10.5px;
  color: #93c5fd;
}

.med-icon {
  font-size: 12px;
}

/* ─── Views & Panels ──────────────────────────────────────────────────────── */
.view-content {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.view-panel {
  display: flex;
  flex-direction: column;
  gap: 14px;
  animation: fadeIn 0.25s ease-out forwards;
}

.hidden {
  display: none !important;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ─── Onboarding ──────────────────────────────────────────────────────────── */
.onboarding-hero {
  text-align: center;
  padding: 16px 8px 8px;
}

.hero-orb {
  width: 54px;
  height: 54px;
  margin: 0 auto 12px;
  background: radial-gradient(circle, var(--lime) 0%, transparent 70%);
  border-radius: 50%;
  animation: pulseGlow 3s infinite ease-in-out;
}

.hero-subtitle {
  font-size: 12.5px;
  color: var(--text-muted);
  margin-top: 4px;
}

.feature-steps {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.step-card {
  display: flex;
  gap: 12px;
  padding: 12px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.step-icon {
  font-size: 18px;
}

.step-info h3 {
  font-size: 12.5px;
  font-weight: 700;
  margin-bottom: 2px;
}

.step-info p {
  font-size: 11px;
  color: var(--text-muted);
}

/* ─── Auth Screen ─────────────────────────────────────────────────────────── */
.auth-box {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.auth-header h2 {
  font-size: 17px;
  font-weight: 700;
}

.auth-header p {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 2px;
}

.btn-oauth {
  background: #ffffff;
  color: #1e293b;
  width: 100%;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: var(--radius);
  padding: 10px 14px;
  border: none;
  cursor: pointer;
  transition: opacity 0.15s;
}

.btn-oauth:hover {
  opacity: 0.92;
}

.oauth-icon {
  width: 18px;
  height: 18px;
}

.divider {
  display: flex;
  align-items: center;
  text-align: center;
  color: var(--text-muted);
  font-size: 11px;
}

.divider::before, .divider::after {
  content: '';
  flex: 1;
  border-bottom: 1px solid var(--border);
}

.divider span {
  padding: 0 10px;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.form-group label {
  font-size: 10.5px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.form-input, .form-textarea {
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 9px 12px;
  color: var(--text);
  font-size: 13px;
  font-family: var(--font);
  outline: none;
  transition: border-color 0.15s;
}

.form-input:focus, .form-textarea:focus {
  border-color: var(--lime);
}

.auth-legal-links {
  font-size: 11px;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.6;
  margin-top: 4px;
}

.text-link {
  background: transparent;
  border: none;
  color: var(--lime);
  font-weight: 600;
  font-size: 11px;
  cursor: pointer;
  padding: 0 2px;
  text-decoration: underline;
}

.error-banner {
  background: rgba(244, 63, 94, 0.12);
  border: 1px solid rgba(244, 63, 94, 0.3);
  color: var(--danger);
  font-size: 11.5px;
  padding: 8px 12px;
  border-radius: 8px;
}

/* ─── Cards & Dashboard ───────────────────────────────────────────────────── */
.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 13px 15px;
}

.metric-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.status-pill {
  font-size: 9.5px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 99px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.pill-low {
  background: rgba(198, 255, 0, 0.12);
  color: var(--lime);
}

.pill-moderate {
  background: rgba(245, 158, 11, 0.15);
  color: var(--warning);
}

.pill-high, .pill-critical {
  background: rgba(244, 63, 94, 0.15);
  color: var(--danger);
}

.gauge-cluster {
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.gauge-number {
  font-size: 36px;
  font-weight: 900;
  line-height: 1;
  color: var(--lime);
  text-shadow: 0 0 16px var(--lime-glow);
}

.gauge-sub {
  font-size: 13px;
  color: var(--text-muted);
}

.progress-bar-bg {
  width: 100%;
  height: 6px;
  background: var(--bg-subtle);
  border-radius: 99px;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 99px;
  background: var(--lime);
  box-shadow: 0 0 10px var(--lime-glow);
  transition: width 0.6s ease;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.stat-card {
  padding: 9px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.stat-label {
  font-size: 9px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
}

.stat-val {
  font-size: 17px;
  font-weight: 800;
  color: var(--text);
}

.stat-meta {
  font-size: 8.5px;
  color: var(--text-muted);
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.info-callout {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 11px;
  color: var(--text-muted);
}

/* ─── Buttons ─────────────────────────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 16px;
  border-radius: 10px;
  font-family: var(--font);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  border: none;
  transition: all 0.15s ease;
}

.btn-lime {
  background: var(--lime);
  color: var(--lime-fg);
  box-shadow: 0 0 18px var(--lime-glow);
}

.btn-lime:hover {
  background: var(--lime-hover);
  box-shadow: 0 0 24px var(--lime-glow);
}

.btn-secondary {
  background: var(--bg-subtle);
  color: var(--text);
  border: 1px solid var(--border);
}

.btn-secondary:hover {
  border-color: var(--lime);
}

.btn-voice {
  background: linear-gradient(135deg, #162032, #101726);
  color: var(--lime);
  border: 1px solid var(--border-active);
  box-shadow: 0 0 16px var(--lime-glow);
}

.btn-voice:hover {
  border-color: var(--lime);
}

.voice-pulse-dot {
  width: 8px;
  height: 8px;
  background: var(--lime);
  border-radius: 50%;
  box-shadow: 0 0 8px var(--lime);
  animation: pulseDot 1.5s infinite;
}

@keyframes pulseDot {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.6); opacity: 0.4; }
  100% { transform: scale(1); opacity: 1; }
}

.btn-danger {
  background: var(--danger);
  color: #ffffff;
}

.btn-ghost {
  background: transparent;
  color: var(--text-muted);
}

.btn-ghost:hover {
  color: var(--text);
}

.w-full { width: 100%; }
.mt-2 { margin-top: 8px; }
.mt-4 { margin-top: 16px; }

/* ─── Voice Session View & Electric Lime Orb Visualizer ───────────────────── */
.voice-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px 0;
  gap: 12px;
}

.neural-orb-wrap {
  position: relative;
  width: 110px;
  height: 110px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.orb-core {
  width: 64px;
  height: 64px;
  background: radial-gradient(circle at 30% 30%, #e2ff66, var(--lime));
  border-radius: 50%;
  position: relative;
  z-index: 2;
  box-shadow: 0 0 30px var(--lime);
  transition: transform 0.08s ease-out;
}

.orb-glow {
  position: absolute;
  width: 100px;
  height: 100px;
  background: radial-gradient(circle, var(--lime-glow) 0%, transparent 70%);
  border-radius: 50%;
  animation: pulseGlow 2.5s infinite ease-in-out;
}

.orb-ring {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(198, 255, 0, 0.3);
}

.ring-1 {
  width: 88px;
  height: 88px;
  animation: spinRing 8s linear infinite;
}

.ring-2 {
  width: 104px;
  height: 104px;
  border-style: dashed;
  animation: spinRing 12s linear infinite reverse;
}

@keyframes pulseGlow {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.15); opacity: 0.9; }
}

@keyframes spinRing {
  to { transform: rotate(360deg); }
}

.voice-status {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--lime);
}

.voice-telemetry-badge {
  font-size: 9.5px;
  font-weight: 700;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  padding: 3px 10px;
  border-radius: 99px;
  color: var(--text-muted);
}

.transcript-container {
  flex: 1;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px;
  display: flex;
  flex-direction: column;
  max-height: 180px;
}

.transcript-header {
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 6px;
}

.transcript-scroll {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.transcript-entry {
  font-size: 11.5px;
  line-height: 1.4;
}

.transcript-entry .speaker-tag {
  font-size: 9px;
  font-weight: 800;
  color: var(--lime);
  margin-right: 4px;
}

/* ─── Legal Panels ────────────────────────────────────────────────────────── */
.legal-panel {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px;
  gap: 12px;
}

.legal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.legal-header h2 {
  font-size: 16px;
  font-weight: 800;
  color: var(--lime);
}

.close-legal-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 14px;
  cursor: pointer;
}

.legal-body {
  font-size: 12px;
  color: var(--text-muted);
  display: flex;
  flex-direction: column;
  gap: 10px;
  line-height: 1.5;
  max-height: 380px;
  overflow-y: auto;
}

.legal-alert-box {
  background: rgba(198, 255, 0, 0.06);
  border: 1px solid rgba(198, 255, 0, 0.2);
  border-radius: 8px;
  padding: 10px;
  color: var(--text);
}

.legal-alert-box strong {
  color: var(--lime);
  display: block;
  margin-bottom: 2px;
}

/* ─── Interactive Tour Overlay ────────────────────────────────────────────── */
.tour-backdrop {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(9, 13, 22, 0.85);
  backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: fadeIn 0.2s ease-out;
}

.tour-card {
  background: var(--card);
  border: 1px solid var(--lime);
  border-radius: var(--radius);
  padding: 18px;
  box-shadow: 0 0 30px var(--lime-glow);
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-width: 280px;
}

.tour-step-badge {
  font-size: 9.5px;
  font-weight: 800;
  text-transform: uppercase;
  color: var(--lime);
}

.tour-card h3 {
  font-size: 15px;
  font-weight: 800;
}

.tour-card p {
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.4;
}

.tour-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 6px;
}

/* ─── Debrief Screen ──────────────────────────────────────────────────────── */
.debrief-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.debrief-header h2 {
  font-size: 16px;
  font-weight: 800;
}

.debrief-header p {
  font-size: 11px;
  color: var(--text-muted);
}

.debrief-metrics {
  background: var(--bg-subtle);
  border-radius: 8px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.debrief-row {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
}

.debrief-row strong {
  color: var(--lime);
}

.debrief-status {
  font-size: 11.5px;
  padding: 8px 10px;
  border-radius: 6px;
  background: rgba(16, 185, 129, 0.12);
  color: var(--success);
}

/* ─── Footer ──────────────────────────────────────────────────────────────── */
.app-footer {
  padding-top: 10px;
  border-top: 1px solid var(--border);
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-links {
  display: flex;
  align-items: center;
  gap: 6px;
}

.footer-link {
  font-size: 10.5px;
  font-weight: 700;
  color: var(--lime);
  text-decoration: none;
}

.footer-dot {
  font-size: 10px;
  color: var(--text-muted);
}

.footer-sublink {
  background: transparent;
  border: none;
  font-size: 10.5px;
  color: var(--text-muted);
  cursor: pointer;
  padding: 0;
}

.footer-sublink:hover {
  color: var(--lime);
  text-decoration: underline;
}

.footer-action {
  font-size: 10.5px;
  color: var(--text-muted);
  background: transparent;
  border: none;
  cursor: pointer;
}

.footer-action:hover {
  color: var(--danger);
}
</file>

<file path="public/favicon.svg">
