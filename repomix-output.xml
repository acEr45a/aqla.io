<file path="extension/sidepanel.css">
/* extension/sidepanel.css */
/* Aqla Neurological Companion — Electric Lime & Dark Obsidian Design System */

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #090d16;           /* Deep Obsidian */
  --bg-subtle: #121926;    /* Slate 900 */
  --card: #151e30;         /* Surface Card */
  --border: rgba(255, 255, 255, 0.08);
  --border-active: rgba(198, 255, 0, 0.5);
  
  --text: #f8fafc;
  --text-muted: #94a3b8;
  
  /* Aqla Signature Electric Lime Brand Accent */
  --lime: #C6FF00;
  --lime-hover: #b4ea00;
  --lime-glow: rgba(198, 255, 0, 0.35);
  --lime-fg: #090d16;

  --primary: #3b82f6;      /* Secondary Blue */
  --success: #10b981;      /* Emerald */
  --warning: #f59e0b;      /* Amber */
  --danger: #f43f5e;       /* Rose Red */

  --font: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
  --radius: 12px;
}

body {
  background-color: var(--bg);
  color: var(--text);
  font-family: var(--font);
  font-size: 13.5px;
  line-height: 1.5;
  min-height: 100vh;
  margin: 0;
  display: flex;
  flex-direction: column;
}

.app-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 16px;
  box-sizing: border-box;
  position: relative;
}

/* ─── Header ──────────────────────────────────────────────────────────────── */
.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 14px;
}

.logo-cluster {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo-mark {
  width: 30px;
  height: 30px;
  background: var(--lime);
  color: var(--lime-fg);
  font-weight: 900;
  font-size: 13px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: -0.5px;
  box-shadow: 0 0 16px var(--lime-glow);
}

.brand-title {
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.06em;
}

.companion-tag {
  font-size: 9.5px;
  color: var(--lime);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-weight: 700;
  display: block;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.icon-btn {
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 4px 6px;
  font-size: 12px;
  cursor: pointer;
  color: var(--text-muted);
  transition: all 0.15s;
}

.icon-btn:hover {
  border-color: var(--lime);
}

.user-pill {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 26px;
  height: 26px;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
  color: var(--lime);
}

/* ─── Medical Banner ──────────────────────────────────────────────────────── */
.medical-banner {
  background: rgba(59, 130, 246, 0.08);
  border: 1px solid rgba(59, 130, 246, 0.2);
  border-radius: 8px;
  padding: 6px 10px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10.5px;
  color: #93c5fd;
}

.med-icon {
  font-size: 12px;
}

/* ─── Views & Panels ──────────────────────────────────────────────────────── */
.view-content {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.view-panel {
  display: flex;
  flex-direction: column;
  gap: 14px;
  animation: fadeIn 0.25s ease-out forwards;
}

.hidden {
  display: none !important;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ─── Onboarding ──────────────────────────────────────────────────────────── */
.onboarding-hero {
  text-align: center;
  padding: 16px 8px 8px;
}

.hero-orb {
  width: 54px;
  height: 54px;
  margin: 0 auto 12px;
  background: radial-gradient(circle, var(--lime) 0%, transparent 70%);
  border-radius: 50%;
  animation: pulseGlow 3s infinite ease-in-out;
}

.hero-subtitle {
  font-size: 12.5px;
  color: var(--text-muted);
  margin-top: 4px;
}

.feature-steps {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.step-card {
  display: flex;
  gap: 12px;
  padding: 12px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.step-icon {
  font-size: 18px;
}

.step-info h3 {
  font-size: 12.5px;
  font-weight: 700;
  margin-bottom: 2px;
}

.step-info p {
  font-size: 11px;
  color: var(--text-muted);
}

/* ─── Auth Screen ─────────────────────────────────────────────────────────── */
.auth-box {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.auth-header h2 {
  font-size: 17px;
  font-weight: 700;
}

.auth-header p {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 2px;
}

.btn-oauth {
  background: #ffffff;
  color: #1e293b;
  width: 100%;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: var(--radius);
  padding: 10px 14px;
  border: none;
  cursor: pointer;
  transition: opacity 0.15s;
}

.btn-oauth:hover {
  opacity: 0.92;
}

.oauth-icon {
  width: 18px;
  height: 18px;
}

.divider {
  display: flex;
  align-items: center;
  text-align: center;
  color: var(--text-muted);
  font-size: 11px;
}

.divider::before, .divider::after {
  content: '';
  flex: 1;
  border-bottom: 1px solid var(--border);
}

.divider span {
  padding: 0 10px;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.form-group label {
  font-size: 10.5px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.form-input, .form-textarea {
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 9px 12px;
  color: var(--text);
  font-size: 13px;
  font-family: var(--font);
  outline: none;
  transition: border-color 0.15s;
}

.form-input:focus, .form-textarea:focus {
  border-color: var(--lime);
}

.auth-legal-links {
  font-size: 11px;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.6;
  margin-top: 4px;
}

.text-link {
  background: transparent;
  border: none;
  color: var(--lime);
  font-weight: 600;
  font-size: 11px;
  cursor: pointer;
  padding: 0 2px;
  text-decoration: underline;
}

.error-banner {
  background: rgba(244, 63, 94, 0.12);
  border: 1px solid rgba(244, 63, 94, 0.3);
  color: var(--danger);
  font-size: 11.5px;
  padding: 8px 12px;
  border-radius: 8px;
}

/* ─── Cards & Dashboard ───────────────────────────────────────────────────── */
.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 13px 15px;
}

.metric-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-eyebrow {
