    const afterRelease = await claimLeases(s.dir,
      { scope: "same", leaf: "leaf", globs: ["src/disjoint/**"] });
    assert(afterRelease.ok, "exact release did not permit a new claim: " + JSON.stringify(afterRelease));
  } finally { s.cleanup(); }
});

