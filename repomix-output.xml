          { label: "Community avg", value: data.consistency.communityAverage },
        ].map((item) => (
          <div key={item.label} className="aqla-panel rounded-2xl p-4">
            <p className="text-[11px] uppercase tracking-wider text-muted-foreground">{item.label}</p>
