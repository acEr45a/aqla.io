        for stack in STACKS:
            for row in _rows(stack):
                if row["Severity"] not in {"Critical", "High"}:
                    continue
                with self.subTest(stack=stack, row=row["No"]):
                    parsed = urlsplit(row["Docs URL"])
                    self.assertEqual(parsed.scheme, "https")
