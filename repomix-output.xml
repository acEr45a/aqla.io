);

export default function AnalyticsPanel({ analytics }) {
  const { funnel, testTypes, domainAverages, engagement } = analytics;

  return (
    <section className="space-y-5">
      <div className="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
