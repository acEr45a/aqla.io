        const protocols = protocolsRes.data || [];
        const visits = visitsRes.data || [];
        const ratings = ratingsRes.data || [];
        const digests = digestsRes.data || [];

        // Build 14-day trailing timeline with exact labels
        const days = [];
        for (let i = 13; i >= 0; i--) {
