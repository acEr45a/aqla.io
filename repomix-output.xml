    "nuxtjs": "nuxtjs 4.5",
    "nuxt-ui": "nuxt-ui 4.10",
}


def _rows(stack):
    path = DATA_DIR / STACK_CONFIG[stack]["file"]
    with path.open(encoding="utf-8", newline="") as handle:
        return list(csv.DictReader(handle))


