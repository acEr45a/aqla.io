const DESKTOP_HIDDEN = ["/settings"];

const SHORT_LABELS = { "Brain Map": "Map", Experiments: "Trials", "AQLA Labs": "Labs", Dashboard: "Home", "AQLA Intelligence": "AQLA" };
const PRIMARY_ROUTES = ["/dashboard", "/map", "/protocol", "/coach"];
