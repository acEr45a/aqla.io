{
  "name": "DailyCheckIn",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "clarity": {
      "type": "number"
    },
    "energy": {
      "type": "number"
    },
    "stress": {
      "type": "number"
    },
    "sleep_quality": {
      "type": "number"
    },
    "caffeine_drinks": {
      "type": "string"
    },
    "caffeine_servings": {
      "type": "number"
    },
    "caffeine_last_time": {
      "type": "string"
    },
    "side_effects": {
      "type": "string"
    },
    "demand": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "valid": {
      "type": "boolean",
      "default": true,
      "description": "False when an admin has invalidated this check-in to force a retake. The record is kept for audit."
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}