{
  "name": "DailyCheckIn",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "clarity": {
      "type": "number"
    },
    "energy": {
      "type": "number"
    },
    "stress": {
      "type": "number"
    },
    "sleep_quality": {
      "type": "number"
    },
    "side_effects": {
      "type": "string"
    },
    "demand": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}