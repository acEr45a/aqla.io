{
  "name": "CognitiveTest",
  "type": "object",
  "properties": {
    "test_type": {
      "type": "string",
      "enum": [
        "reaction_time",
        "sustained_attention",
        "memory_recall",
        "working_memory",
        "task_switching",
        "visual_spatial",
        "verbal_fluency"
      ]
    },
    "raw_results": {
      "type": "object",
      "additionalProperties": true
    },
    "normalized_score": {
      "type": "number"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "valid": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "test_type",
    "normalized_score"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}