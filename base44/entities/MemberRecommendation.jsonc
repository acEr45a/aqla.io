{
  "name": "MemberRecommendation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The target member this recommendation is pushed to"
    },
    "title": {
      "type": "string",
      "description": "Short headline shown in the dashboard pop-up and email subject"
    },
    "message": {
      "type": "string",
      "description": "The recommendation body"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "protocol",
        "safety",
        "lifestyle",
        "follow_up"
      ],
      "default": "general"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "dismissed"
      ],
      "default": "active",
      "description": "active = shown as a pop-up on the member dashboard; acknowledged/dismissed stop the pop-up"
    }
  },
  "required": [
    "user_id",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        }
      ]
    }
  }
}