{
  "name": "BrainDomain",
  "type": "object",
  "properties": {
    "domain_key": {
      "type": "string"
    },
    "domain_name": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high"
      ],
      "default": "moderate"
    },
    "trend": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "stable"
      ],
      "default": "stable"
    },
    "summary": {
      "type": "string"
    },
    "limiting_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protective_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "domain_key",
    "domain_name",
    "score"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}