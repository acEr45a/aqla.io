{
  "name": "GameRating",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Identifier of the rated game from the training catalog"
    },
    "game_name": {
      "type": "string",
      "description": "Display name of the rated game"
    },
    "stars": {
      "type": "number",
      "description": "Star rating from 1 to 5",
      "minimum": 1,
      "maximum": 5
    },
    "feedback": {
      "type": "string",
      "description": "Optional written feedback from the player"
    }
  },
  "required": [
    "game_id",
    "game_name",
    "stars"
  ],
  "rls": {
    "read": null,
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}