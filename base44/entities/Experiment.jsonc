{
  "name": "Experiment",
  "type": "object",
  "properties": {
    "hypothesis": {
      "type": "string"
    },
    "intervention": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "baseline",
        "intervention",
        "analysis",
        "complete"
      ],
      "default": "baseline"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "duration_days": {
      "type": "number"
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confounders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string"
          },
          "change": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "neutral"
            ]
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "too_early",
        "possible_benefit",
        "likely_benefit",
        "no_clear_effect",
        "possible_negative",
        "likely_negative"
      ]
    },
    "adherence": {
      "type": "number"
    },
    "decision": {
      "type": "string"
    }
  },
  "required": [
    "hypothesis",
    "intervention"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}