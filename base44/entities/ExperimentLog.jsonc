{
  "name": "ExperimentLog",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "variable": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "timing": {
      "type": "string"
    },
    "perceived_effect": {
      "type": "string",
      "enum": [
        "better",
        "same",
        "worse"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "variable"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}