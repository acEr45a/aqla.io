{
  "name": "PdfArchive",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "end_of_plan",
        "plan"
      ]
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "protocol_id": {
      "type": "string"
    },
    "family": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "title",
    "date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}