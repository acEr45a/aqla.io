{
  "name": "DevIdea",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short refined name of the idea"
    },
    "raw_input": {
      "type": "string",
      "description": "What the admin originally said"
    },
    "summary": {
      "type": "string",
      "description": "One-line refined description shown in the checklist row"
    },
    "detail": {
      "type": "string",
      "description": "Refined detail shown on hover \u2014 depth scales with tier"
    },
    "tier": {
      "type": "string",
      "enum": [
        "big_idea",
        "feature",
        "improvement",
        "small_fix"
      ],
      "default": "feature"
    },
    "impact": {
      "type": "string"
    },
    "effort": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "done"
      ],
      "default": "open"
    },
    "source": {
      "type": "string",
      "enum": [
        "chat",
        "wordbank",
        "manual"
      ],
      "default": "manual"
    }
  },
  "required": [
    "title",
    "tier"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}