{
  "name": "CaptchaConfig",
  "type": "object",
  "properties": {
    "v3_site_key": {
      "type": "string",
      "description": "Public reCAPTCHA v3 site key, embedded client-side"
    },
    "v3_secret_key": {
      "type": "string",
      "description": "Server-only reCAPTCHA v3 secret key, never exposed to the client"
    },
    "v2_site_key": {
      "type": "string",
      "description": "Public reCAPTCHA v2 site key for the fallback checkbox"
    },
    "v2_secret_key": {
      "type": "string",
      "description": "Server-only reCAPTCHA v2 secret key, never exposed to the client"
    },
    "score_threshold": {
      "type": "number",
      "default": 0.5,
      "description": "v3 score at or above which login proceeds; below triggers the v2 challenge"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}