{
  "name": "GameSession",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "raw_results": {
      "type": "object",
      "additionalProperties": true
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "game_id",
    "score",
    "completed_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}