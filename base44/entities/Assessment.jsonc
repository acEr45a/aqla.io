{
  "name": "Assessment",
  "type": "object",
  "properties": {
    "responses": {
      "type": "object",
      "additionalProperties": true
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    }
  },
  "required": [
    "responses"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}