    {
      "function_name": "getAdminDashboardMetrics",
      "description": "Fetch aggregate platform metrics: users, registrations, activity, protocol mix."
    },
    {
      "function_name": "sendSummaryEmails",
      "description": "Trigger the summary email job for users due a digest."
    },
    {
