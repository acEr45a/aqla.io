      "description": "Fetch aggregated community insights across all users"
    },
    {
      "function_name": "manageUserRoles",
      "description": "Manage app user roles (promote/demote between admin and user)"
    },
    {
      "function_name": "backendOpsAi",
      "description": "Central AI compute for all admin surfaces. { task: 'refineIdea', raw: '...' } refines a raw development idea into a ranked, detailed checklist item; { task: 'wordbank', focus: '...' } generates ranked wordbank ideas; { task: 'pdfTheme', instruction: '...' } restyles the branded Fable PDF document theme."
    },
    {
      "function_name": "getMemberData",
      "description": "Fetch cross-user daily check-ins and protocols with member names, for the Member data admin view. Optional { user_id } to scope to one member."
    },
    {
      "function_name": "invalidateCheckIn",
      "description": "Mark a daily check-in as invalid (valid=false) so the user can submit a fresh one. The original record is kept. Payload: { check_in_id }. Always confirm the target with the admin before running."
    },
    {
      "function_name": "completeCognitiveBaseline",
      "description": "Auto-completes a user's cognitive baseline: writes passing CognitiveTest records for all seven tests and blends the scores into their Brain Map domains. Use to unstick a user whose onboarding is blocked by the cognitive baseline tests. Payload: { user_id: '<target user id>' }."
    },
    {
      "function_name": "resolveAppIssue",
      "description": "Resolve an issue surfaced by the app health scan (runAppDiagnostics). Payload: { action: '<resolve_action>' }. Supported actions: 'cleanup_expired_otps' (deletes expired, unused admin verification codes), 'kick_onboard_users' (returns the list of users who never finished an assessment). Always confirm the action with the admin before running."
    }
  ],
